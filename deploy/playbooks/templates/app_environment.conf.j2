[Service]
# This file is managed by Ansible
# It provides environment variables to the {{ service_name }} service.

# Mandatory params
Environment="BINANCE_REST_API_URI={{ binance_rest_api_uri }}"
Environment="BINANCE_FIX_API_HOSTNAME_ORDERENTRY={{ binance_fix_api_hostname_orderentry }}"
Environment="BINANCE_FIX_API_HOSTNAME_MARKETDATA={{ binance_fix_api_hostname_marketdata }}"
Environment="BINANCE_ED25519_SEED={{ binance_ed25519_seed }}"
Environment="BINANCE_ED25519_API_KEY={{ binance_ed25519_api_key }}"

# Rest is optional

{% if binance_fix_api_port_orderentry is defined %}
Environment="BINANCE_FIX_API_PORT_ORDERENTRY={{ binance_fix_api_port_orderentry }}"
{% endif %}

{% if binance_fix_api_port_marketdata is defined %}
Environment="BINANCE_FIX_API_PORT_MARKETDATA={{ binance_fix_api_port_marketdata }}"
{% endif %}

{% if max_trading_path_length is defined %}
Environment="MAX_TRADING_PATH_LENGTH={{ max_trading_path_length }}"
{% endif %}

{% if assets is defined %}
Environment="ASSETS={{ assets }}"
{% endif %}

{% if commission is defined %}
Environment="COMMISSION={{ commission }}"
{% endif %}

{% if log_level is defined %}
Environment="LOG_LEVEL={{ log_level }}"
{% endif %}

{% if sslkeylogfile is defined %}
Environment="SSLKEYLOGFILE={{ sslkeylogfile }}"
{% endif %}

{% if static_tradingpaths is defined %}
Environment="STATIC_TRADINGPATHS={{ static_tradingpaths }}"
{% endif %}

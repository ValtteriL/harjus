{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/prometheus_metrics.log",
            "log_group_name": "/ecs/prometheus_metrics",
            "log_stream_name": "prometheus_metrics_stream"
          }
        ]
      }
    }
  },
  "metrics": {
    "metrics_collected": {
      "prometheus": {
        "prometheus_config_path": "/etc/cwagentconfig/prometheus.yaml",
        "prometheus_port": 3333
      }
    }
  }
}

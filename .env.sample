# Sample .env file for Harjus arbitrage bot
# Copy this file to .env and fill in the required values

# Binance REST API base URL (use testnet for testing)
# Required
BINANCE_REST_API_URI="https://testnet.binance.vision"

# FIX market data endpoint hostname
# Required
BINANCE_FIX_API_HOSTNAME_MARKETDATA="fix-md.testnet.binance.vision"
# BINANCE_FIX_API_HOSTNAME_MARKETDATA="fix-md.binance.com"

# FIX order entry endpoint hostname
# Required
BINANCE_FIX_API_HOSTNAME_ORDERENTRY="fix-oe.testnet.binance.vision"
# BINANCE_FIX_API_HOSTNAME_ORDERENTRY="fix-oe.binance.com"

# Your Binance Ed25519 API key see ./docs/binance.md for instructions
# Required
BINANCE_ED25519_API_KEY=

# Ed25519 private key seed see ./docs/binance.md for instructions
# Required
BINANCE_ED25519_SEED=

# Log verbosity: 0=debug, 1=info, 2=warn, 3=error
# Optional, default=1
# LOG_LEVEL=1

# Max hops in an arbitrage path (e.g., 3 = triangular arb)
# Optional, default=3
# MAX_TRADING_PATH_LENGTH=3

# Exchange trading fee as decimal
# Optional, default=0.001 (0.1%)
# COMMISSION=0.001

# Comma-separated list of assets to monitor for arb opportunities
# Optional, default=all assets
# ASSETS="ETH,BTC,USDT,BNB,ADA,XRP,DOT,LTC,SOL,AVAX,LINK"

# Predefined arb paths; format: SYMBOL:LONG|SHORT,...; separated by semicolons
# Optional, default=all possible paths within ASSETS
# STATIC_TRADINGPATHS="BTCUSDT:LONG,ETHBTC:LONG,ETHUSDT:SHORT;DOGEUSDT:LONG,DOGEETH:SHORT,ETHUSDT:SHORT"

# SSL key logging for Wireshark TLS traffic decryption
# Uncomment and set to a file path to enable TLS session key export
# Optional, default=disabled
# SSLKEYLOGFILE=/tmp/harjus-sslkeys.log
